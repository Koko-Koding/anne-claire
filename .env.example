# FTP deploy config for scripts/deploy-ftp.js
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Bun auto-loads `.env`, so no extra tooling is needed.

# FTP server hostname (no ftp:// prefix)
FTP_HOST=ftp.anneclairevanputten.nl

# FTP port (optional, defaults to 21)
#FTP_PORT=21

# Credentials
FTP_USER=your-ftp-username
FTP_PASSWORD=your-ftp-password

# The site's web root on the server. This directory is MIRRORED: files in _site/
# are uploaded and anything else under this path is DELETED. Point it at the web
# root, NOT the server root. Common Plesk paths: /httpdocs or /<domain>/httpdocs
FTP_REMOTE_DIR=/httpdocs

# Connection security:
#   auto  = try FTPS (encrypted), fall back to plain FTP if TLS is refused (default)
#   true  = require FTPS, fail if unavailable
#   false = plain FTP (credentials sent in cleartext — avoid)
FTP_SECURE=auto

# Set to true ONLY if the host's FTPS certificate is self-signed or has a
# hostname mismatch (common on shared hosting). Skips TLS verification, which
# weakens MITM protection. Leave unset to verify certificates.
#FTP_TLS_INSECURE=true
